VITE_APP_TITLE = 'JeeSite'
VITE_APP_PORT = 9000

# Uni-App ID
VITE_UNI_APPID = '__UNI__841DCAE'

# 微信小程序 ID
VITE_WX_APPID = 'wx335f34af8ccb4131'

# h5部署网站的base，配置到 manifest.config.ts 里的 h5.router.base
# https://uniapp.dcloud.net.cn/collocation/manifest.html#h5-router
VITE_APP_PUBLIC_BASE=/app/

# 默认语言（fallback locale）
VITE_FALLBACK_LOCALE = 'zh-Hans'

# 产品信息
VITE_PRODUCT_NAME = 'JeeSite Mobile'
VITE_COMPANY_NAME = 'ThinkGem'
VITE_PRODUCT_VERSION = '5.0.0'
VITE_PRODUCT_VERSION_CODE = '100'

# 管理基础路径
VITE_ADMIN_PATH = '/a'

# 后台请求地址（默认使用第一个服务器地址）
VITE_SERVER_BASEURL = 'https://demo.jeesite.com/js'

# 服务器地址列表配置
# 格式：VITE_SERVER_{N}_NAME, VITE_SERVER_{N}_URL, VITE_SERVER_{N}_VALUE
VITE_SERVER_1_NAME = 'https://demo.jeesite.com'
VITE_SERVER_1_URL = 'https://demo.jeesite.com/js'
VITE_SERVER_1_VALUE = '0'

VITE_SERVER_2_NAME = 'http://127.0.0.1:8980'
VITE_SERVER_2_URL = 'http://127.0.0.1:8980/js'
VITE_SERVER_2_VALUE = '1'

# 注意：如果是微信小程序，还有一套请求地址的配置，根据 develop、trial、release
#      分别设置上传地址，见 `src/utils/index.ts`。

# h5 是否需要配置代理
VITE_APP_PROXY_ENABLE = false

# 下面的不用修改，只要不跟你后台的统一前缀冲突就行。如果修改了，记得修改 `nginx` 里面的配置
VITE_APP_PROXY_PREFIX = '/js'

# 认证模式，'single' | 'double' ==> 单token | 双token
VITE_AUTH_MODE = 'single'

# 原生插件资源复制开关，控制是否启用 copy-native-resources 插件
VITE_COPY_NATIVE_RES_ENABLE = false
